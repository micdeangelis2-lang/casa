# Copia questo file in .env.local (non viene mai committato) e compila i valori.
# Su Vercel le stesse variabili si impostano nelle Environment Variables del progetto.

# Postgres (Neon, regione UE). Usa la stringa "pooled" del pooler.
DATABASE_URL=postgres://utente:password@host/database?sslmode=require

# Connessioni massime del pool (default 5). Opzionale.
# DATABASE_POOL_MAX=5

# Segreto di Better Auth, almeno 32 caratteri. Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origine pubblica dell'app, senza slash finale. Da qui derivano origin e rpID delle passkey:
# le passkey sono legate al dominio, quindi in produzione serve un dominio stabile.
BETTER_AUTH_URL=http://localhost:3000

# Token monouso per creare l'account del proprietario (almeno 32 caratteri,
# genera con: openssl rand -base64 32). Serve solo finche' non esiste un utente:
# dopo la configurazione iniziale RIMUOVILO dall'ambiente.
OWNER_BOOTSTRAP_TOKEN=

# Cartella dei file dei documenti (solo adattatore su disco: sviluppo e test). Predefinita: .storage
# STORAGE_DIR=.storage

# Backup (incremento 3). Chiave PUBBLICA in PEM, con i ritorni a capo scritti come backslash-n
# su una riga sola. Genera la coppia con `pnpm backup:keygen`.
# La chiave privata resta a te (fuori dal server): senza di lei i backup non si aprono.
# BACKUP_PUBLIC_KEY=
# Segreto che firma i backup (HMAC-SHA256, almeno 32 caratteri; genera con: openssl rand -base64 32). Consigliato:
# il ripristino rifiuta un backup senza firma o con firma diversa. Custodiscilo anche fuori dal server (serve per ripristinare).
# BACKUP_SIGNING_SECRET=
# BACKUP_DIR=backups
# BACKUP_KEEP=14
# Segreto del cron (almeno 16 caratteri): Vercel lo manda come "Authorization: Bearer ...".
# CRON_SECRET=

# Email degli avvisi (Resend). Facoltative: senza, gli avvisi restano solo nell app.
# RESEND_API_KEY=
# MAIL_FROM=
